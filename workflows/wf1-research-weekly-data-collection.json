{
  "name": "SEO Research - Weekly Data Collection",
  "nodes": [
    {
      "id": "trigger_1",
      "name": "Weekly Research Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": ["monday"],
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "http_france_1",
      "name": "Get France Blog Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [500, 200],
      "parameters": {
        "method": "POST",
        "url": "https://searchconsole.googleapis.com/webmasters/v3/sites/sc-domain%3Afr.getaround.com/searchAnalytics/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"startDate\": \"{{ $now.minus(7, 'days').toFormat('yyyy-MM-dd') }}\",\n  \"endDate\": \"{{ $now.minus(1, 'days').toFormat('yyyy-MM-dd') }}\",\n  \"dimensions\": [\"page\", \"query\"],\n  \"dimensionFilterGroups\": [{\"filters\": [{\"dimension\": \"page\", \"operator\": \"contains\", \"expression\": \"/blog/\"}]}],\n  \"rowLimit\": 500\n}"
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true
    },
    {
      "id": "http_norway_1",
      "name": "Get Norway Blog Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [500, 400],
      "parameters": {
        "method": "POST",
        "url": "https://searchconsole.googleapis.com/webmasters/v3/sites/sc-domain%3Ano.getaround.com/searchAnalytics/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"startDate\": \"{{ $now.minus(7, 'days').toFormat('yyyy-MM-dd') }}\",\n  \"endDate\": \"{{ $now.minus(1, 'days').toFormat('yyyy-MM-dd') }}\",\n  \"dimensions\": [\"page\", \"query\"],\n  \"dimensionFilterGroups\": [{\"filters\": [{\"dimension\": \"page\", \"operator\": \"contains\", \"expression\": \"/blogg/\"}]}],\n  \"rowLimit\": 500\n}"
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true
    },
    {
      "id": "merge_1",
      "name": "Merge GSC Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [750, 300],
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex"
      }
    },
    {
      "id": "code_1",
      "name": "Identify Opportunities",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "jsCode": "// Process GSC data to identify SEO opportunities\nconst items = $input.all();\nconst opportunities = [];\n\nfor (const item of items) {\n  const rows = item.json.rows || [];\n  \n  for (const row of rows) {\n    const clicks = row.clicks || 0;\n    const impressions = row.impressions || 0;\n    const ctr = row.ctr || 0;\n    const position = row.position || 0;\n    const page = row.keys?.[0] || '';\n    const query = row.keys?.[1] || '';\n    \n    // CTR Gap: High impressions but low CTR (potential quick wins)\n    if (impressions > 100 && ctr < 0.02) {\n      opportunities.push({\n        type: 'ctr_gap',\n        page,\n        query,\n        impressions,\n        clicks,\n        ctr: (ctr * 100).toFixed(2) + '%',\n        position: position.toFixed(1),\n        recommendation: 'Optimize title/meta for this query'\n      });\n    }\n    \n    // Position Opportunity: Good position but could be better\n    if (position > 3 && position < 15 && impressions > 50) {\n      opportunities.push({\n        type: 'position_opportunity',\n        page,\n        query,\n        impressions,\n        clicks,\n        ctr: (ctr * 100).toFixed(2) + '%',\n        position: position.toFixed(1),\n        recommendation: 'Content refresh to improve ranking'\n      });\n    }\n  }\n}\n\n// Sort by impressions descending\nopportunities.sort((a, b) => b.impressions - a.impressions);\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    totalOpportunities: opportunities.length,\n    ctrGaps: opportunities.filter(o => o.type === 'ctr_gap').length,\n    positionOpportunities: opportunities.filter(o => o.type === 'position_opportunity').length,\n    opportunities: opportunities.slice(0, 50)\n  }\n}];"
      }
    },
    {
      "id": "sheets_1",
      "name": "Save Weekly Report",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1250, 200],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_SEO_REPORT_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Weekly Reports"
        },
        "columns": {
          "mappingMode": "autoMapInputData"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "slack_1",
      "name": "Send Weekly Report",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [1250, 400],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_SEO_CHANNEL_ID }}"
        },
        "text": "=\ud83d\udcca *Weekly SEO Research Report*\n\n*Generated:* {{ $json.timestamp }}\n*Total Opportunities:* {{ $json.totalOpportunities }}\n\n*CTR Gaps:* {{ $json.ctrGaps }} (high impressions, low clicks)\n*Position Opportunities:* {{ $json.positionOpportunities }} (ranking 4-15)\n\nTop 5 opportunities have been saved to Google Sheets.",
        "otherOptions": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Weekly Research Trigger": {
      "main": [
        [
          {"node": "Get France Blog Data", "type": "main", "index": 0},
          {"node": "Get Norway Blog Data", "type": "main", "index": 0}
        ]
      ]
    },
    "Get France Blog Data": {
      "main": [[{"node": "Merge GSC Data", "type": "main", "index": 0}]]
    },
    "Get Norway Blog Data": {
      "main": [[{"node": "Merge GSC Data", "type": "main", "index": 1}]]
    },
    "Merge GSC Data": {
      "main": [[{"node": "Identify Opportunities", "type": "main", "index": 0}]]
    },
    "Identify Opportunities": {
      "main": [
        [
          {"node": "Save Weekly Report", "type": "main", "index": 0},
          {"node": "Send Weekly Report", "type": "main", "index": 0}
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
